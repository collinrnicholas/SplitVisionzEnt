# Split Vizions — lead capture env

# REQUIRED: Resend API key (https://resend.com) — free tier get u to 3,000 emails/mo
# Grab a key from Resend → Settings → API Keys. Add your verified sending domain.
RESEND_API_KEY=

# REQUIRED: OpenAI API key — powers the conversational chatbot (gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL overrides. Defaults shown:
# Where leads are emailed
# LEAD_TO_EMAIL=dcstylez149@yahoo.com

# From address. Use onboarding@resend.dev for testing (emails marked from "onboarding@resend.dev");
# once your domain is verified, use something like "Split Vizions <leads@yourdomain.com>".
# RESEND_FROM_EMAIL=Split Vizions <onboarding@resend.dev>

# OPTIONAL: Supabase — logs every lead into a `leads` table (queryable later).
# https://supabase.com/dashboard → your project → Settings → API
# SUPABASE_URL=
# Use the service role key (server-side only — never expose in client code).
# SUPABASE_SERVICE_ROLE_KEY=
